# Copy this file to .env.local and fill in your own Supabase project's
# values (see supabase project settings > API). .env.local is gitignored —
# real keys are never committed, same rule as before, just Vite's convention
# instead of config.template.js -> config.js.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE-YOUR-ANON-PUBLIC-KEY-HERE
